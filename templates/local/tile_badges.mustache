{{!
    @template format_coursify/local/tile_badges

    Badges of a tile: up next, this week, current, opens on, hidden from students; and its dates.

    Example context (json):
    {"isnext": true, "iscurrent": false, "hiddenfromstudents": false, "daterange": "3 March - 9 March", "isthisweek": true}
}}
<span class="coursify-tile__badges">
    {{#isnext}}<span class="badge coursify-badge-next">{{#str}}upnext, format_coursify{{/str}}</span>{{/isnext}}
    {{#isthisweek}}<span class="badge text-bg-info">{{#str}}thisweek, format_coursify{{/str}}</span>{{/isthisweek}}
    {{^isthisweek}}{{#iscurrent}}<span class="badge text-bg-primary">{{#str}}current, format_coursify{{/str}}</span>{{/iscurrent}}{{/isthisweek}}
    {{#opens}}<span class="badge text-bg-light border">{{#str}}opens, format_coursify, {{opens}}{{/str}}</span>{{/opens}}
    {{#hiddenfromstudents}}<span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>{{/hiddenfromstudents}}
</span>
{{#daterange}}
<span class="coursify-tile__dates"><i class="fa fa-regular fa-calendar" aria-hidden="true"></i> {{daterange}}</span>
{{/daterange}}
