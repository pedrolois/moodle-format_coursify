{{!
    @template format_formatium/local/tile_badges

    Badges of a tile: next, current, hidden from students.

    Example context (json):
    {"isnext": true, "iscurrent": false, "hiddenfromstudents": false}
}}
<div class="formatium-tile__badges">
    {{#isnext}}<span class="badge formatium-badge-next">{{#str}}upnext, format_formatium{{/str}}</span>{{/isnext}}
    {{#iscurrent}}<span class="badge text-bg-primary">{{#str}}current, format_formatium{{/str}}</span>{{/iscurrent}}
    {{#hiddenfromstudents}}<span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>{{/hiddenfromstudents}}
</div>
