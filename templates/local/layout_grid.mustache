{{!
    @template format_formatium/local/layout_grid

    Tiles as a grid of cards, by groups.

    Example context (json):
    {
        "columns": 3,
        "groups": [
            {"id": "formatium-group-0", "name": "", "hasname": false, "tiles": [
                {"id": 35, "num": 1, "steplabel": "1", "headinglevel": 3, "name": "Getting started", "url": "#",
                 "summary": "First steps.", "color": "blue", "icon": "rocket", "activities": 4, "isnext": true,
                 "progress": {"total": 4, "done": 2, "percent": 50, "started": true, "label": "2 of 4"} }
            ]}
        ]
    }
}}
{{#groups}}
<section class="formatium-groupblock" data-region="formatium-group"{{#hasname}} aria-labelledby="{{id}}"{{/hasname}}>
{{#hasname}}{{> format_formatium/local/group_heading }}{{/hasname}}
<ul class="formatium-grid formatium-grid--cols-{{columns}}" aria-label="{{#str}}tiles, format_formatium{{/str}}">
    {{#tiles}}
    <li class="formatium-tile formatium-tile--{{color}}{{#locked}} formatium-tile--locked{{/locked}}{{#iscurrent}} formatium-tile--current{{/iscurrent}}{{#isnext}} formatium-tile--next{{/isnext}}{{#progress.complete}} formatium-tile--complete{{/progress.complete}}"
        data-sectionid="{{id}}" data-number="{{num}}" data-region="formatium-tile"
        data-status="{{#locked}}locked{{/locked}}{{^locked}}{{#progress.complete}}done{{/progress.complete}}{{^progress.complete}}todo{{/progress.complete}}{{/locked}}">
        {{#url}}<a class="formatium-tile__link" href="{{url}}">{{/url}}
        {{^url}}<div class="formatium-tile__link" aria-disabled="true">{{/url}}
            <div class="formatium-tile__media{{#imageurl}} formatium-tile__media--image{{/imageurl}}"
                 {{#imageurl}}style="background-image: url('{{imageurl}}')"{{/imageurl}}>
                {{^imageurl}}
                <span class="formatium-tile__icon" aria-hidden="true">
                    {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                    {{^icon}}<span class="formatium-tile__number">{{steplabel}}</span>{{/icon}}
                </span>
                {{/imageurl}}
                {{#locked}}
                <span class="formatium-tile__lock" title="{{#str}}locked, format_formatium{{/str}}">
                    <i class="fa fa-solid fa-lock" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}}locked, format_formatium{{/str}}</span>
                </span>
                {{/locked}}
                {{#progress.complete}}
                <span class="formatium-tile__check" title="{{#str}}tilecomplete, format_formatium{{/str}}">
                    <i class="fa fa-solid fa-check" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}}tilecomplete, format_formatium{{/str}}</span>
                </span>
                {{/progress.complete}}
            </div>
            <div class="formatium-tile__body">
                {{> format_formatium/local/tile_badges }}
                <h{{headinglevel}} class="formatium-tile__title">{{name}}</h{{headinglevel}}>
                {{#summary}}<p class="formatium-tile__summary">{{summary}}</p>{{/summary}}
                {{#lockinfo}}<div class="formatium-tile__lockinfo">{{{lockinfo}}}</div>{{/lockinfo}}
                <div class="formatium-tile__footer">
                    <span class="formatium-tile__count">
                        {{^locked}}
                        {{#progress.label}}{{progress.label}}{{/progress.label}}
                        {{^progress.label}}{{#str}}activitiescount, format_formatium, {{activities}}{{/str}}{{/progress.label}}
                        {{/locked}}
                    </span>
                    {{#progress}}{{> format_formatium/local/tile_ring }}{{/progress}}
                </div>
            </div>
        {{#url}}</a>{{/url}}
        {{^url}}</div>{{/url}}
    </li>
    {{/tiles}}
</ul>
</section>
{{/groups}}
