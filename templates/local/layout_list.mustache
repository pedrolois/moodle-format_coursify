{{!
    @template format_coursify/local/layout_list

    Tiles as a compact list, one row per section, by groups.

    Example context (json):
    {
        "groups": [
            {"id": "coursify-group-0", "name": "", "hasname": false, "tiles": [
                {"id": 35, "num": 1, "steplabel": "1", "name": "Getting started", "url": "#", "summary": "First steps.",
                 "color": "blue", "icon": "rocket", "activities": 4,
                 "progress": {"total": 4, "done": 2, "percent": 50, "started": true, "label": "2 of 4"} }
            ]}
        ]
    }
}}
{{#groups}}
<section class="coursify-groupblock" data-region="coursify-group"{{#hasname}} aria-labelledby="{{id}}"{{/hasname}}>
{{#hasname}}{{> format_coursify/local/group_heading }}{{/hasname}}
<ul class="coursify-list" aria-label="{{#str}}tiles, format_coursify{{/str}}">
    {{#tiles}}
    <li class="coursify-row coursify-tile--{{color}}{{#locked}} coursify-tile--locked{{/locked}}{{#isnext}} coursify-tile--next{{/isnext}}{{#iscurrent}} coursify-tile--current{{/iscurrent}}{{#progress.complete}} coursify-tile--complete{{/progress.complete}}"
        data-sectionid="{{id}}" data-number="{{num}}" data-region="coursify-tile"
        data-status="{{#locked}}locked{{/locked}}{{^locked}}{{#progress.complete}}done{{/progress.complete}}{{^progress.complete}}todo{{/progress.complete}}{{/locked}}">
        {{#url}}<a class="coursify-row__link" href="{{url}}">{{/url}}
        {{^url}}<div class="coursify-row__link" aria-disabled="true">{{/url}}
            <span class="coursify-row__icon{{#imageurl}} coursify-row__icon--image{{/imageurl}}" aria-hidden="true"
                  {{#imageurl}}style="background-image: url('{{imageurl}}')"{{/imageurl}}>
                {{^imageurl}}
                {{#locked}}<i class="fa fa-solid fa-lock"></i>{{/locked}}
                {{^locked}}
                {{#progress.complete}}<i class="fa fa-solid fa-check"></i>{{/progress.complete}}
                {{^progress.complete}}
                {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                {{^icon}}<span class="coursify-tile__number">{{steplabel}}</span>{{/icon}}
                {{/progress.complete}}
                {{/locked}}
                {{/imageurl}}
            </span>
            <span class="coursify-row__content">
                <span class="coursify-row__title">
                    {{name}}
                    {{#isnext}}<span class="badge coursify-badge-next">{{#str}}upnext, format_coursify{{/str}}</span>{{/isnext}}
                    {{#isthisweek}}<span class="badge text-bg-info">{{#str}}thisweek, format_coursify{{/str}}</span>{{/isthisweek}}
                    {{^isthisweek}}{{#iscurrent}}<span class="badge text-bg-primary">{{#str}}current, format_coursify{{/str}}</span>{{/iscurrent}}{{/isthisweek}}
                    {{#opens}}<span class="badge text-bg-light border">{{#str}}opens, format_coursify, {{opens}}{{/str}}</span>{{/opens}}
                    {{#hiddenfromstudents}}<span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>{{/hiddenfromstudents}}
                    {{#locked}}<span class="visually-hidden">{{#str}}locked, format_coursify{{/str}}</span>{{/locked}}
                </span>
                {{#summary}}<span class="coursify-row__summary">{{summary}}</span>{{/summary}}
                {{#daterange}}<span class="coursify-tile__dates"><i class="fa fa-regular fa-calendar" aria-hidden="true"></i> {{daterange}}</span>{{/daterange}}
                {{#lockinfo}}<span class="coursify-tile__lockinfo">{{{lockinfo}}}</span>{{/lockinfo}}
            </span>
            <span class="coursify-row__meta">
                {{^locked}}
                <span class="coursify-row__count">
                    {{#progress.label}}{{progress.label}}{{/progress.label}}
                    {{^progress.label}}{{#str}}activitiescount, format_coursify, {{activities}}{{/str}}{{/progress.label}}
                </span>
                {{/locked}}
                {{#progress}}{{> format_coursify/local/tile_progress }}{{/progress}}
            </span>
            {{#url}}<i class="fa fa-solid fa-chevron-right coursify-row__chevron" aria-hidden="true"></i>{{/url}}
        {{#url}}</a>{{/url}}
        {{^url}}</div>{{/url}}
    </li>
    {{/tiles}}
</ul>
</section>
{{/groups}}
