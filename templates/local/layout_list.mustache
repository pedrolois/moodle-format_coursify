{{!
    @template format_formatium/local/layout_list

    Tiles as a compact list, one row per section.

    Example context (json):
    {
        "tiles": [
            {"id": 35, "num": 1, "step": 1, "name": "Getting started", "url": "#", "summary": "First steps.",
             "color": "blue", "icon": "rocket", "activities": 4,
             "progress": {"total": 4, "done": 2, "percent": 50, "started": true} }
        ]
    }
}}
<ul class="formatium-list" aria-label="{{#str}}tiles, format_formatium{{/str}}">
    {{#tiles}}
    <li class="formatium-row formatium-tile--{{color}}{{#locked}} formatium-tile--locked{{/locked}}{{#isnext}} formatium-tile--next{{/isnext}}{{#iscurrent}} formatium-tile--current{{/iscurrent}}{{#progress.complete}} formatium-tile--complete{{/progress.complete}}"
        data-sectionid="{{id}}" data-number="{{num}}">
        {{#url}}<a class="formatium-row__link" href="{{url}}">{{/url}}
        {{^url}}<div class="formatium-row__link" aria-disabled="true">{{/url}}
            <span class="formatium-row__icon{{#imageurl}} formatium-row__icon--image{{/imageurl}}" aria-hidden="true"
                  {{#imageurl}}style="background-image: url('{{imageurl}}')"{{/imageurl}}>
                {{^imageurl}}
                {{#locked}}<i class="fa fa-solid fa-lock"></i>{{/locked}}
                {{^locked}}
                {{#progress.complete}}<i class="fa fa-solid fa-check"></i>{{/progress.complete}}
                {{^progress.complete}}
                {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                {{^icon}}<span class="formatium-tile__number">{{step}}</span>{{/icon}}
                {{/progress.complete}}
                {{/locked}}
                {{/imageurl}}
            </span>
            <span class="formatium-row__content">
                <span class="formatium-row__title">
                    {{name}}
                    {{#isnext}}<span class="badge formatium-badge-next">{{#str}}upnext, format_formatium{{/str}}</span>{{/isnext}}
                    {{#iscurrent}}<span class="badge text-bg-primary">{{#str}}current, format_formatium{{/str}}</span>{{/iscurrent}}
                    {{#hiddenfromstudents}}<span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>{{/hiddenfromstudents}}
                    {{#locked}}<span class="visually-hidden">{{#str}}locked, format_formatium{{/str}}</span>{{/locked}}
                </span>
                {{#summary}}<span class="formatium-row__summary">{{summary}}</span>{{/summary}}
                {{#lockinfo}}<span class="formatium-tile__lockinfo">{{{lockinfo}}}</span>{{/lockinfo}}
            </span>
            <span class="formatium-row__meta">
                {{^locked}}<span class="formatium-row__count">{{#str}}activitiescount, format_formatium, {{activities}}{{/str}}</span>{{/locked}}
                {{#progress}}{{> format_formatium/local/tile_ring }}{{/progress}}
            </span>
            {{#url}}<i class="fa fa-solid fa-chevron-right formatium-row__chevron" aria-hidden="true"></i>{{/url}}
        {{#url}}</a>{{/url}}
        {{^url}}</div>{{/url}}
    </li>
    {{/tiles}}
</ul>
