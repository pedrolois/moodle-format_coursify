{{!
    @template format_coursify/local/tile_ring

    Progress ring of a tile (the context is the progress of the tile).

    Example context (json):
    {"total": 4, "done": 1, "percent": 25, "started": true}
}}
{{#total}}
<span class="coursify-ring" role="img"
      aria-label="{{#str}}tileprogress, format_coursify, { "done": {{done}}, "total": {{total}} }{{/str}}">
    <svg viewBox="0 0 36 36" aria-hidden="true" focusable="false">
        <circle class="coursify-ring__track" cx="18" cy="18" r="15.9155"></circle>
        {{#started}}
        <circle class="coursify-ring__value" cx="18" cy="18" r="15.9155"
                stroke-dasharray="{{percent}} 100"></circle>
        {{/started}}
    </svg>
    <span class="coursify-ring__text" aria-hidden="true">{{percent}}%</span>
</span>
{{/total}}
