{{!
    @template format_coursify/local/tile_progress

    Progress of a tile in the style chosen for the course: a ring, a bar or the percentage. The context is the
    progress of the tile; progressring, progressbar and progresspercent come from the course page.

    Example context (json):
    {"total": 4, "done": 1, "percent": 25, "started": true, "complete": false, "progressbar": true}
}}
{{#total}}
{{#progressring}}{{> format_coursify/local/tile_ring }}{{/progressring}}
{{#progressbar}}
<span class="coursify-pbar{{#complete}} coursify-pbar--done{{/complete}}" role="progressbar"
      aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"
      aria-label="{{#str}}tileprogress, format_coursify, { "done": {{done}}, "total": {{total}} }{{/str}}">
    <span class="coursify-pbar__track"><span class="coursify-pbar__value" style="width: {{percent}}%"></span></span>
    <span class="coursify-pbar__text" aria-hidden="true">{{percent}}%</span>
</span>
{{/progressbar}}
{{#progresspercent}}
<span class="coursify-ppct{{#complete}} coursify-ppct--done{{/complete}}" role="img"
      aria-label="{{#str}}tileprogress, format_coursify, { "done": {{done}}, "total": {{total}} }{{/str}}">{{percent}}%</span>
{{/progresspercent}}
{{/total}}
