{{!
    @template format_coursify/local/content

    Course page of the Coursify format. With tilesmode it shows the general section, the progress of the course,
    the next activity to do and a tile per section; otherwise it is the standard course content (edit mode and
    section pages), plus links to the previous and next tiles on section pages.

    Example context (json):
    {
        "tilesmode": true,
        "hastiles": true,
        "columns": 3,
        "sectionreturn": "null",
        "pagesectionid": "null",
        "overallprogress": {"total": 10, "done": 4, "percent": 40, "complete": false},
        "continue": {"url": "#", "name": "Quiz 1", "section": "Topic 2", "iconurl": ""},
        "tiles": [
            {
                "id": 35, "num": 1, "name": "Getting started", "url": "#", "summary": "First steps.",
                "color": "blue", "icon": "rocket", "iscurrent": true, "locked": false, "activities": 4,
                "progress": {"total": 4, "done": 2, "percent": 50, "complete": false, "started": true}
            },
            {
                "id": 36, "num": 2, "name": "Advanced", "url": "", "summary": "", "color": "default", "icon": "",
                "locked": true, "lockinfo": "Not available unless: you complete Getting started", "activities": 3
            }
        ]
    }
}}
{{#tilesmode}}
<div id="course-format-{{uniqid}}" class="coursify">
    <h2 class="visually-hidden">{{{title}}}</h2>
    {{#banner}}
    <section class="coursify-banner{{^hasimage}} coursify-banner--generated{{/hasimage}}"
             style="background-image: url('{{imageurl}}'); background-position: center {{position}}%;"
             aria-label="{{#str}}coursebanner, format_coursify{{/str}}">
        <div class="coursify-banner__scrim">
            {{#summary}}<p class="coursify-banner__summary">{{summary}}</p>{{/summary}}
            {{#hascontacts}}
            <ul class="coursify-banner__contacts" aria-label="{{#str}}coursecontacts, format_coursify{{/str}}">
                {{#contacts}}
                <li>
                    <a href="{{url}}" class="coursify-banner__contact">
                        {{{picture}}}
                        <span><span class="coursify-banner__contactname">{{name}}</span><span class="coursify-banner__contactrole">{{role}}</span></span>
                    </a>
                </li>
                {{/contacts}}
            </ul>
            {{/hascontacts}}
            {{#hassummary}}
            <div class="coursify-banner__summarybox">
                {{> format_coursify/local/course_summary }}
            </div>
            {{/hassummary}}
        </div>
    </section>
    {{/banner}}
    {{#initialsection}}
    <ul class="{{format}} section-list coursify-general" data-for="course_sectionlist">
        {{$ core_courseformat/local/content/section }}
            {{< core_courseformat/local/content/section }}
                {{$ core_courseformat/local/content/section/collapsemenu }}{{/ core_courseformat/local/content/section/collapsemenu }}
            {{/ core_courseformat/local/content/section }}
        {{/ core_courseformat/local/content/section }}
    </ul>
    {{/initialsection}}

    {{^banner}}
    {{#hassummary}}
    <div class="coursify-summary">
        {{> format_coursify/local/course_summary }}
    </div>
    {{/hassummary}}
    {{/banner}}

    {{#showfilters}}
    <div class="coursify-filters" role="group" aria-label="{{#str}}filtertiles, format_coursify{{/str}}" data-region="coursify-filters">
        <button type="button" class="btn btn-sm coursify-filter" data-filter="all" aria-pressed="true">{{#str}}filter_all, format_coursify{{/str}}</button>
        <button type="button" class="btn btn-sm coursify-filter" data-filter="todo" aria-pressed="false">{{#str}}filter_todo, format_coursify{{/str}}</button>
        <button type="button" class="btn btn-sm coursify-filter" data-filter="done" aria-pressed="false">{{#str}}filter_done, format_coursify{{/str}}</button>
    </div>
    {{/showfilters}}

    {{#hastiles}}
    <div class="coursify-tiles" data-region="coursify-tiles">
    {{#isgrid}}{{> format_coursify/local/layout_grid }}{{/isgrid}}
    {{#ispath}}{{> format_coursify/local/layout_path }}{{/ispath}}
    {{#islist}}{{> format_coursify/local/layout_list }}{{/islist}}
    {{#ismap}}{{> format_coursify/local/layout_map }}{{/ismap}}
    <p class="coursify-empty text-muted" data-region="coursify-nomatch" hidden>{{#str}}nomatch, format_coursify{{/str}}</p>
    </div>
    {{/hastiles}}
    {{^hastiles}}
    <p class="coursify-empty text-muted">{{#str}}notiles, format_coursify{{/str}}</p>
    {{/hastiles}}
</div>
{{#js}}
require(['core_courseformat/local/content'], function(component) {
    component.init('#page', {}, null, null);
});
{{/js}}
{{/tilesmode}}
{{^tilesmode}}
{{#coursifystrip}}
<nav class="coursify-strip" aria-label="{{#str}}sectionnavigation, format_coursify{{/str}}">
    <a class="coursify-strip__all" href="{{courseurl}}" title="{{#str}}alltiles, format_coursify{{/str}}">
        <i class="fa fa-solid fa-table-cells-large" aria-hidden="true"></i>
        <span class="visually-hidden">{{#str}}alltiles, format_coursify{{/str}}</span>
    </a>
    <ol class="coursify-strip__list">
        {{#tiles}}
        <li class="coursify-tile--{{color}}{{#locked}} coursify-tile--locked{{/locked}}{{#progress.complete}} coursify-tile--complete{{/progress.complete}}">
            {{#url}}<a class="coursify-strip__item" href="{{url}}"{{#iscurrentpage}} aria-current="page"{{/iscurrentpage}} title="{{name}}">{{/url}}
            {{^url}}<span class="coursify-strip__item" aria-disabled="true" title="{{name}} ({{#str}}locked, format_coursify{{/str}})">{{/url}}
                <span class="coursify-strip__chip" aria-hidden="true">
                    {{#locked}}<i class="fa fa-solid fa-lock"></i>{{/locked}}
                    {{^locked}}{{#progress.complete}}<i class="fa fa-solid fa-check"></i>{{/progress.complete}}{{^progress.complete}}{{steplabel}}{{/progress.complete}}{{/locked}}
                </span>
                <span class="coursify-strip__name">{{name}}</span>
            {{#url}}</a>{{/url}}
            {{^url}}</span>{{/url}}
        </li>
        {{/tiles}}
    </ol>
</nav>
{{/coursifystrip}}
{{> core_courseformat/local/content }}
{{#coursifynav}}
<nav class="coursify-sectionnav" aria-label="{{#str}}sectionnavigation, format_coursify{{/str}}">
    <div class="coursify-sectionnav__side">
        {{#previous}}
        <a class="btn btn-outline-secondary" href="{{url}}">
            <i class="fa fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}}previous, format_coursify{{/str}}:</span> {{name}}
        </a>
        {{/previous}}
    </div>
    <a class="btn btn-link" href="{{courseurl}}">
        <i class="fa fa-solid fa-table-cells-large" aria-hidden="true"></i> {{#str}}alltiles, format_coursify{{/str}}
    </a>
    <div class="coursify-sectionnav__side coursify-sectionnav__side--end">
        {{#next}}
        <a class="btn btn-outline-secondary" href="{{url}}">
            <span class="visually-hidden">{{#str}}next, format_coursify{{/str}}:</span> {{name}}
            <i class="fa fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        {{/next}}
    </div>
</nav>
{{/coursifynav}}
{{/tilesmode}}
