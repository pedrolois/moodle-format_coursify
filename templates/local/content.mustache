{{!
    @template format_formatium/local/content

    Course page of the Formatium format. With tilesmode it shows the general section, the progress of the course,
    the next activity to do and a tile per section; otherwise it is the standard course content (edit mode and
    section pages), plus links to the previous and next tiles on section pages.

    Example context (json):
    {
        "tilesmode": true,
        "hastiles": true,
        "columns": 3,
        "sectionreturn": "null",
        "pagesectionid": "null",
        "overallprogress": {"total": 10, "done": 4, "percent": 40, "complete": false},
        "continue": {"url": "#", "name": "Quiz 1", "section": "Topic 2", "iconurl": ""},
        "tiles": [
            {
                "id": 35, "num": 1, "name": "Getting started", "url": "#", "summary": "First steps.",
                "color": "blue", "icon": "rocket", "iscurrent": true, "locked": false, "activities": 4,
                "progress": {"total": 4, "done": 2, "percent": 50, "complete": false, "started": true}
            },
            {
                "id": 36, "num": 2, "name": "Advanced", "url": "", "summary": "", "color": "default", "icon": "",
                "locked": true, "lockinfo": "Not available unless: you complete Getting started", "activities": 3
            }
        ]
    }
}}
{{#tilesmode}}
<div id="course-format-{{uniqid}}" class="formatium">
    <h2 class="visually-hidden">{{{title}}}</h2>
    {{#initialsection}}
    <ul class="{{format}} section-list formatium-general" data-for="course_sectionlist">
        {{$ core_courseformat/local/content/section }}
            {{< core_courseformat/local/content/section }}
                {{$ core_courseformat/local/content/section/collapsemenu }}{{/ core_courseformat/local/content/section/collapsemenu }}
            {{/ core_courseformat/local/content/section }}
        {{/ core_courseformat/local/content/section }}
    </ul>
    {{/initialsection}}

    {{#overallprogress}}
    <div class="formatium-summary">
        <div class="formatium-summary__progress">
            <div class="formatium-summary__label">
                <span>{{#str}}courseprogress, format_formatium{{/str}}</span>
                <strong>{{percent}}%</strong>
            </div>
            <div class="progress formatium-bar" role="progressbar" aria-label="{{#str}}courseprogress, format_formatium{{/str}}"
                 aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: {{percent}}%"></div>
            </div>
            <div class="formatium-summary__count small text-muted">
                {{#str}}activitiesdone, format_formatium, { "done": {{done}}, "total": {{total}} }{{/str}}
            </div>
        </div>
        {{#continue}}
        <a class="btn btn-primary formatium-continue" href="{{url}}">
            <span class="formatium-continue__text">
                <span class="formatium-continue__label">{{#str}}continue, format_formatium{{/str}}</span>
                <span class="formatium-continue__name">{{name}}</span>
            </span>
            <i class="fa fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        {{/continue}}
        {{#coursecomplete}}
        <div class="formatium-done">
            <i class="fa fa-solid fa-trophy" aria-hidden="true"></i>
            <span>{{#str}}coursecomplete, format_formatium{{/str}}</span>
        </div>
        {{/coursecomplete}}
    </div>
    {{/overallprogress}}
    {{^overallprogress}}
    {{#continue}}
    <div class="formatium-summary">
        <a class="btn btn-primary formatium-continue" href="{{url}}">
            <span class="formatium-continue__text">
                <span class="formatium-continue__label">{{#str}}continue, format_formatium{{/str}}</span>
                <span class="formatium-continue__name">{{name}}</span>
            </span>
            <i class="fa fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
    {{/continue}}
    {{/overallprogress}}

    {{#hastiles}}
    <ul class="formatium-grid formatium-grid--cols-{{columns}}" aria-label="{{#str}}tiles, format_formatium{{/str}}">
        {{#tiles}}
        <li class="formatium-tile formatium-tile--{{color}}{{#locked}} formatium-tile--locked{{/locked}}{{#iscurrent}} formatium-tile--current{{/iscurrent}}{{#progress.complete}} formatium-tile--complete{{/progress.complete}}"
            data-sectionid="{{id}}" data-number="{{num}}">
            {{#url}}<a class="formatium-tile__link" href="{{url}}">{{/url}}
            {{^url}}<div class="formatium-tile__link" aria-disabled="true">{{/url}}
                <div class="formatium-tile__media{{#imageurl}} formatium-tile__media--image{{/imageurl}}"
                     {{#imageurl}}style="background-image: url('{{imageurl}}')"{{/imageurl}}>
                    {{^imageurl}}
                    <span class="formatium-tile__icon" aria-hidden="true">
                        {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                        {{^icon}}<span class="formatium-tile__number">{{num}}</span>{{/icon}}
                    </span>
                    {{/imageurl}}
                    {{#locked}}
                    <span class="formatium-tile__lock" title="{{#str}}locked, format_formatium{{/str}}">
                        <i class="fa fa-solid fa-lock" aria-hidden="true"></i>
                        <span class="visually-hidden">{{#str}}locked, format_formatium{{/str}}</span>
                    </span>
                    {{/locked}}
                    {{#progress.complete}}
                    <span class="formatium-tile__check" title="{{#str}}tilecomplete, format_formatium{{/str}}">
                        <i class="fa fa-solid fa-check" aria-hidden="true"></i>
                        <span class="visually-hidden">{{#str}}tilecomplete, format_formatium{{/str}}</span>
                    </span>
                    {{/progress.complete}}
                </div>
                <div class="formatium-tile__body">
                    <div class="formatium-tile__badges">
                        {{#iscurrent}}<span class="badge text-bg-primary">{{#str}}current, format_formatium{{/str}}</span>{{/iscurrent}}
                        {{#hiddenfromstudents}}<span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>{{/hiddenfromstudents}}
                    </div>
                    <h3 class="formatium-tile__title">{{name}}</h3>
                    {{#summary}}<p class="formatium-tile__summary">{{summary}}</p>{{/summary}}
                    {{#lockinfo}}<div class="formatium-tile__lockinfo">{{{lockinfo}}}</div>{{/lockinfo}}
                    <div class="formatium-tile__footer">
                        <span class="formatium-tile__count">
                            {{^locked}}{{#str}}activitiescount, format_formatium, {{activities}}{{/str}}{{/locked}}
                        </span>
                        {{#progress}}
                        {{#total}}
                        <span class="formatium-ring" role="img"
                              aria-label="{{#str}}tileprogress, format_formatium, { "done": {{done}}, "total": {{total}} }{{/str}}">
                            <svg viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                                <circle class="formatium-ring__track" cx="18" cy="18" r="15.5" pathLength="100"></circle>
                                {{#started}}
                                <circle class="formatium-ring__value" cx="18" cy="18" r="15.5" pathLength="100"
                                        stroke-dasharray="{{percent}} 100"></circle>
                                {{/started}}
                            </svg>
                            <span class="formatium-ring__text" aria-hidden="true">{{percent}}%</span>
                        </span>
                        {{/total}}
                        {{/progress}}
                    </div>
                </div>
            {{#url}}</a>{{/url}}
            {{^url}}</div>{{/url}}
        </li>
        {{/tiles}}
    </ul>
    {{/hastiles}}
    {{^hastiles}}
    <p class="formatium-empty text-muted">{{#str}}notiles, format_formatium{{/str}}</p>
    {{/hastiles}}
</div>
{{#js}}
require(['core_courseformat/local/content'], function(component) {
    component.init('#page', {}, null, null);
});
{{/js}}
{{/tilesmode}}
{{^tilesmode}}
{{> core_courseformat/local/content }}
{{#formatiumnav}}
<nav class="formatium-sectionnav" aria-label="{{#str}}sectionnavigation, format_formatium{{/str}}">
    <div class="formatium-sectionnav__side">
        {{#previous}}
        <a class="btn btn-outline-secondary" href="{{url}}">
            <i class="fa fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}}previous, format_formatium{{/str}}:</span> {{name}}
        </a>
        {{/previous}}
    </div>
    <a class="btn btn-link" href="{{courseurl}}">
        <i class="fa fa-solid fa-table-cells-large" aria-hidden="true"></i> {{#str}}alltiles, format_formatium{{/str}}
    </a>
    <div class="formatium-sectionnav__side formatium-sectionnav__side--end">
        {{#next}}
        <a class="btn btn-outline-secondary" href="{{url}}">
            <span class="visually-hidden">{{#str}}next, format_formatium{{/str}}:</span> {{name}}
            <i class="fa fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        {{/next}}
    </div>
</nav>
{{/formatiumnav}}
{{/tilesmode}}
