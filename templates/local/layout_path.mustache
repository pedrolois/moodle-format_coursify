{{!
    @template format_coursify/local/layout_path

    Tiles as a learning path: numbered steps along a line, the cards alternating sides on wide screens. Group names
    are milestones on the line.

    Example context (json):
    {
        "groups": [
            {"id": "coursify-group-0", "name": "Unit 1", "hasname": true, "done": 1, "count": 1, "tiles": [
                {"id": 35, "num": 1, "step": 1, "steplabel": "1", "steps": "2", "side": "start", "name": "Getting started",
                 "url": "#", "summary": "First steps.", "color": "blue", "icon": "rocket", "activities": 4,
                 "progress": {"total": 4, "done": 4, "percent": 100, "complete": true, "started": true, "label": "Done"} }
            ]}
        ]
    }
}}
<ol class="coursify-path" aria-label="{{#str}}tiles, format_coursify{{/str}}">
    {{#groups}}
    {{#hasname}}
    <li class="coursify-path__group" data-region="coursify-group">
        {{> format_coursify/local/group_heading }}
    </li>
    {{/hasname}}
    {{#tiles}}
    <li class="coursify-step coursify-tile--{{color}} coursify-step--{{side}}{{#locked}} coursify-tile--locked{{/locked}}{{#isnext}} coursify-tile--next{{/isnext}}{{#iscurrent}} coursify-tile--current{{/iscurrent}}{{#progress.complete}} coursify-tile--complete{{/progress.complete}}{{#islast}} coursify-step--last{{/islast}}"
        data-sectionid="{{id}}" data-number="{{num}}" data-region="coursify-tile"
        data-status="{{#locked}}locked{{/locked}}{{^locked}}{{#progress.complete}}done{{/progress.complete}}{{^progress.complete}}todo{{/progress.complete}}{{/locked}}">
        <div class="coursify-step__node" aria-hidden="true">
            {{#progress}}
            {{#total}}
            <svg class="coursify-step__ring" viewBox="0 0 36 36" focusable="false">
                <circle class="coursify-ring__track" cx="18" cy="18" r="16.5" pathLength="100"></circle>
                {{#started}}
                <circle class="coursify-ring__value" cx="18" cy="18" r="16.5" pathLength="100"
                        stroke-dasharray="{{percent}} 100"></circle>
                {{/started}}
            </svg>
            {{/total}}
            {{/progress}}
            <span class="coursify-step__icon">
                {{#locked}}<i class="fa fa-solid fa-lock"></i>{{/locked}}
                {{^locked}}
                {{#progress.complete}}<i class="fa fa-solid fa-check"></i>{{/progress.complete}}
                {{^progress.complete}}
                {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                {{^icon}}<span class="coursify-tile__number">{{steplabel}}</span>{{/icon}}
                {{/progress.complete}}
                {{/locked}}
            </span>
        </div>
        {{#url}}<a class="coursify-step__card" href="{{url}}">{{/url}}
        {{^url}}<div class="coursify-step__card" aria-disabled="true">{{/url}}
            {{#imageurl}}<span class="coursify-step__image" style="background-image: url('{{imageurl}}')"></span>{{/imageurl}}
            <span class="coursify-step__content">
                <span class="coursify-step__label">
                    {{#str}}stepof, format_coursify, { "step": "{{steplabel}}", "steps": "{{steps}}" }{{/str}}
                    {{#locked}}· {{#str}}locked, format_coursify{{/str}}{{/locked}}
                    {{#progress.complete}}· {{#str}}tilecomplete, format_coursify{{/str}}{{/progress.complete}}
                </span>
                {{> format_coursify/local/tile_badges }}
                <span class="coursify-step__title h5">{{name}}</span>
                {{#summary}}<span class="coursify-step__summary">{{summary}}</span>{{/summary}}
                {{#lockinfo}}<span class="coursify-tile__lockinfo">{{{lockinfo}}}</span>{{/lockinfo}}
                <span class="coursify-step__meta">
                    {{^locked}}{{#str}}activitiescount, format_coursify, {{activities}}{{/str}}{{/locked}}
                    {{#progress.label}} · {{progress.label}}{{/progress.label}}
                </span>
            </span>
        {{#url}}</a>{{/url}}
        {{^url}}</div>{{/url}}
    </li>
    {{/tiles}}
    {{/groups}}
</ol>
