{{!
    @template format_formatium/local/layout_path

    Tiles as a learning path: numbered steps along a line, the cards alternating sides on wide screens.

    Example context (json):
    {
        "tiles": [
            {"id": 35, "num": 1, "step": 1, "steps": 2, "side": "start", "name": "Getting started", "url": "#",
             "summary": "First steps.", "color": "blue", "icon": "rocket", "activities": 4,
             "progress": {"total": 4, "done": 4, "percent": 100, "complete": true, "started": true} },
            {"id": 36, "num": 2, "step": 2, "steps": 2, "side": "end", "islast": true, "name": "Advanced", "url": "#",
             "summary": "", "color": "default", "icon": "", "activities": 3, "isnext": true,
             "progress": {"total": 3, "done": 0, "percent": 0, "started": false} }
        ]
    }
}}
<ol class="formatium-path" aria-label="{{#str}}tiles, format_formatium{{/str}}">
    {{#tiles}}
    <li class="formatium-step formatium-tile--{{color}} formatium-step--{{side}}{{#locked}} formatium-tile--locked{{/locked}}{{#isnext}} formatium-tile--next{{/isnext}}{{#iscurrent}} formatium-tile--current{{/iscurrent}}{{#progress.complete}} formatium-tile--complete{{/progress.complete}}{{#islast}} formatium-step--last{{/islast}}"
        data-sectionid="{{id}}" data-number="{{num}}">
        <div class="formatium-step__node" aria-hidden="true">
            {{#progress}}
            {{#total}}
            <svg class="formatium-step__ring" viewBox="0 0 36 36" focusable="false">
                <circle class="formatium-ring__track" cx="18" cy="18" r="16.5" pathLength="100"></circle>
                {{#started}}
                <circle class="formatium-ring__value" cx="18" cy="18" r="16.5" pathLength="100"
                        stroke-dasharray="{{percent}} 100"></circle>
                {{/started}}
            </svg>
            {{/total}}
            {{/progress}}
            <span class="formatium-step__icon">
                {{#locked}}<i class="fa fa-solid fa-lock"></i>{{/locked}}
                {{^locked}}
                {{#progress.complete}}<i class="fa fa-solid fa-check"></i>{{/progress.complete}}
                {{^progress.complete}}
                {{#icon}}<i class="fa fa-solid fa-{{icon}}"></i>{{/icon}}
                {{^icon}}<span class="formatium-tile__number">{{step}}</span>{{/icon}}
                {{/progress.complete}}
                {{/locked}}
            </span>
        </div>
        {{#url}}<a class="formatium-step__card" href="{{url}}">{{/url}}
        {{^url}}<div class="formatium-step__card" aria-disabled="true">{{/url}}
            {{#imageurl}}<span class="formatium-step__image" style="background-image: url('{{imageurl}}')"></span>{{/imageurl}}
            <span class="formatium-step__content">
                <span class="formatium-step__label">
                    {{#str}}stepof, format_formatium, { "step": {{step}}, "steps": {{steps}} }{{/str}}
                    {{#locked}}· {{#str}}locked, format_formatium{{/str}}{{/locked}}
                    {{#progress.complete}}· {{#str}}tilecomplete, format_formatium{{/str}}{{/progress.complete}}
                </span>
                {{> format_formatium/local/tile_badges }}
                <span class="formatium-step__title h5">{{name}}</span>
                {{#summary}}<span class="formatium-step__summary">{{summary}}</span>{{/summary}}
                {{#lockinfo}}<span class="formatium-tile__lockinfo">{{{lockinfo}}}</span>{{/lockinfo}}
                <span class="formatium-step__meta">
                    {{^locked}}{{#str}}activitiescount, format_formatium, {{activities}}{{/str}}{{/locked}}
                    {{#progress}}{{#total}} · {{#str}}tileprogress, format_formatium, { "done": {{done}}, "total": {{total}} }{{/str}}{{/total}}{{/progress}}
                </span>
            </span>
        {{#url}}</a>{{/url}}
        {{^url}}</div>{{/url}}
    </li>
    {{/tiles}}
</ol>
