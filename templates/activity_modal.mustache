{{!
    @template format_coursify/activity_modal

    Body of the window that shows a page, a PDF file or a video over the course page.

    Example context (json):
    {"ishtml": true, "html": "<p>Welcome</p>", "viewurl": "#", "title": "Welcome page"}
}}
<div class="coursify-modal">
    {{#ishtml}}<div class="coursify-modal__html">{{{html}}}</div>{{/ishtml}}
    {{#isembed}}
    <div class="coursify-modal__video">
        <iframe src="{{url}}" title="{{title}}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen loading="lazy"></iframe>
    </div>
    {{/isembed}}
    {{#ispdf}}
    <iframe class="coursify-modal__pdf" src="{{url}}" title="{{title}}"></iframe>
    {{/ispdf}}
    <p class="coursify-modal__full">
        <a href="{{viewurl}}">{{#str}}openfullpage, format_coursify{{/str}} <i class="fa fa-solid fa-up-right-from-square" aria-hidden="true"></i></a>
    </p>
</div>
