{{!
    @template format_coursify/preview

    Column with the live preview of the course page, next to the Coursify settings of the course edit form.
    The course page is rendered into the canvas by format_coursify/preview.

    Example context (json):
    {}
}}
<div class="coursify-preview-column">
    <div class="coursify-preview">
        <div class="coursify-preview__bar">
            <span class="coursify-preview__dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <strong class="coursify-preview__title">{{#str}}preview, format_coursify{{/str}}</strong>
            <span class="coursify-preview__change" hidden></span>
            <span class="coursify-preview__status" role="status"></span>
        </div>
        <div class="coursify-preview__viewport" inert>
            <div class="coursify-preview__canvas"></div>
        </div>
        <p class="coursify-preview__hint small text-muted mb-0">{{#str}}previewhint, format_coursify{{/str}}</p>
    </div>
</div>
